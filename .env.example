# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These values are public (they ship to every browser). Security comes from database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (blocks bots). reCAPTCHA Enterprise SITE key from Firebase console > App Check.
# Public, like the values above. Leave empty to turn App Check off (e.g. on forks).
VITE_RECAPTCHA_SITE_KEY=

# Crash reports (Sentry). The DSN from Sentry > Project settings > Client keys. Public.
# Leave empty to turn crash reports off.
VITE_SENTRY_DSN=

# --- Server only (no VITE_ prefix: never sent to browsers) ---
# AI Notes. Google AI Studio > Get API key. Put it in Vercel env vars too.
GEMINI_API_KEY=
# Optional: pick another Gemini model if Google retires the default.
GEMINI_MODEL=
# The Wall (front page sticky notes) saves notes from the server after checking them.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON file on ONE line. Secret: .env.local and Vercel only.
FIREBASE_SERVICE_ACCOUNT=
# Lepak Pages takedowns from /admin. Supabase > Project Settings > API keys > service_role
# (secret). It skips all of Supabase's access rules: .env.local and Vercel only, never in
# a VITE_ variable, never in the code.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Lepak Pages). Project Settings > API. The anon/publishable key is public.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
