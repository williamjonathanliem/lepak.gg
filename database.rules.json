{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rooms": {
      "katabomb": {
        ".indexOn": ["updatedAt"],
        "$code": {
          ".read": "auth != null",
          ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
          ".write": "auth != null && !newData.exists() && data.child('updatedAt').val() < now - 86400000",
          "state": {
            ".write": "auth != null && newData.exists() && newData.child('hostId').val() === auth.uid && (!data.exists() || data.child('hostId').val() === auth.uid || (!data.parent().child('presence').child(data.child('hostId').val()).exists() && data.parent().child('presence').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['phase', 'hostId', 'settings', 'seq'])"
          },
          "updatedAt": {
            ".write": "auth != null && data.parent().child('state/hostId').val() === auth.uid || (auth != null && !data.parent().child('state').exists())",
            ".validate": "newData.val() === now"
          },
          "intents": {
            "$id": {
              ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (!newData.exists() && root.child('rooms/katabomb').child($code).child('state/hostId').val() === auth.uid))",
              ".validate": "newData.hasChildren(['from', 'data', 'at']) && newData.child('at').val() === now",
              "from": {
                ".validate": "newData.isString()"
              },
              "at": {
                ".validate": true
              },
              "data": {
                ".validate": "newData.hasChildren(['type'])",
                "type": {
                  ".validate": "newData.isString() && newData.val().matches(/^(join|ready|submit|leave|style)$/)"
                },
                "nickname": {
                  ".validate": "newData.isString() && newData.val().length <= 32"
                },
                "ready": {
                  ".validate": "newData.isBoolean()"
                },
                "word": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "color": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
                },
                "emoji": {
                  ".validate": "newData.isString() && newData.val().length <= 8"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "chat": {
            ".indexOn": ["at"],
            "$id": {
              ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid",
              ".validate": "newData.hasChildren(['from', 'nick', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 200 && newData.child('nick').isString() && newData.child('nick').val().length <= 16 && newData.child('at').val() === now"
            }
          },
          "typing": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          },
          "presence": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "wall": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["updatedAt"],
      "$noteId": {
        ".write": "auth != null && !newData.exists() && data.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['text', 'kind', 'color', 'nick', 'uid', 'updatedAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 140"
        },
        "kind": {
          ".validate": "newData.isString() && newData.val().matches(/^(idea|bug|love)$/)"
        },
        "color": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
        },
        "uid": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "approved": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        },
        "pinned": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "wallPlus": {
      ".read": "auth != null",
      "$noteId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('wall').child($noteId).exists())",
          ".validate": "newData.val() === true"
        }
      },
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "wallLast": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "votes": {
      ".read": "auth != null",
      "$appId": {
        ".validate": "$appId.matches(/^[a-z0-9-]{2,30}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "(newData.isBoolean() && newData.val() === true) || newData.val() === now"
        }
      },
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "boards": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        ".write": "auth != null && !newData.exists() && data.child('updatedAt').val() < now - 1209600000",
        "elements": {
          "$id": {
            ".write": "auth != null",
            ".validate": "$id.length <= 64 && newData.hasChildren(['v', 'd']) && newData.child('v').isNumber() && newData.child('d').isString() && newData.child('d').val().length <= 30000"
          }
        },
        "files": {
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "$id.length <= 64 && newData.hasChildren(['m', 'd']) && newData.child('m').isString() && newData.child('m').val().beginsWith('image/') && newData.child('d').isString() && newData.child('d').val().beginsWith('data:image/') && newData.child('d').val().length <= 700000"
          }
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "cursors": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y', 'n']) && newData.child('x').isNumber() && newData.child('y').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 16"
          }
        }
      },
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "bingo": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        ".write": "auth != null && !newData.exists() && data.child('updatedAt').val() < now - 86400000",
        "game": {
          ".write": "auth != null && newData.child('hostId').val() === auth.uid && (!data.exists() || data.child('hostId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostId', 'items'])"
        },
        "updatedAt": {
          ".write": "auth != null && (!data.parent().child('game').exists() || data.parent().child('game/hostId').val() === auth.uid)",
          ".validate": "newData.val() === now"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        },
        "claims": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('bingo').child($code).child('game/hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['nick', 'at']) && newData.child('nick').isString() && newData.child('nick').val().length <= 16 && newData.child('at').val() === now"
          }
        },
        "hostHere": {
          ".write": "auth != null && root.child('bingo').child($code).child('game/hostId').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        }
      },
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "rtc": {
      "$code": {
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        ".write": "auth != null && !newData.exists() && data.child('updatedAt').val() < now - 86400000",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'app']) && newData.child('host').val() === auth.uid && (newData.child('app').val() === 'watch' || newData.child('app').val() === 'drop')"
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        },
        "peers": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 16"
          }
        },
        "inbox": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            ".write": "auth != null && auth.uid === $to && !newData.exists()",
            "$msg": {
              ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (!newData.exists() && auth.uid === $to))",
              ".validate": "newData.hasChildren(['from', 's', 't', 'd']) && newData.child('s').isString() && newData.child('s').val().length <= 20 && newData.child('t').isString() && newData.child('t').val().length <= 10 && newData.child('d').isString() && newData.child('d').val().length <= 20000"
            }
          }
        },
        "chat": {
          ".read": "auth != null",
          "$msg": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['from', 'n', 'text', 'at']) && newData.child('from').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('at').val() === now"
          }
        }
      },
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "collab": {
      ".indexOn": ["updatedAt"],
      "$room": {
        ".validate": "$room.matches(/^[a-f0-9]{64}$/)",
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('updatedAt').val() < now - 86400000",
        "seeded": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === true"
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        },
        "updates": {
          "$id": {
            ".write": "auth != null && (!data.exists() || !newData.exists())",
            ".validate": "newData.isString() && newData.val().length <= 300000"
          }
        },
        "peers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 16"
          }
        }
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "wallReports": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$noteId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('wall').child($noteId).exists())",
          ".validate": "newData.val() === true"
        }
      }
    },
    "wallBans": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".validate": "newData.isNumber()"
      }
    },
    "deadlines": {
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        "meta": {
          ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['owner', 'title', 'open']) && newData.child('owner').val() === (data.exists() ? data.child('owner').val() : auth.uid) && newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 60 && newData.child('open').isBoolean()"
        },
        "items": {
          "$id": {
            ".write": "auth != null && (root.child('deadlines').child($code).child('meta/owner').val() === auth.uid || (root.child('deadlines').child($code).child('meta/open').val() === true && (!data.exists() || data.child('byUid').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['title', 'due', 'by', 'byUid']) && newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 80 && newData.child('due').isNumber() && newData.child('by').isString() && newData.child('by').val().length <= 16 && (newData.child('byUid').val() === auth.uid || newData.child('byUid').val() === data.child('byUid').val())",
            "course": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "title": {
              ".validate": true
            },
            "due": {
              ".validate": true
            },
            "by": {
              ".validate": true
            },
            "byUid": {
              ".validate": true
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "updatedAt": {
          ".write": "auth != null && root.child('deadlines').child($code).child('meta').exists() || auth != null && newData.parent().child('meta').exists()",
          ".validate": "newData.val() === now"
        }
      }
    },
    "free": {
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        "meta": {
          ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['owner', 'title', 'days', 'from', 'to']) && newData.child('title').isString() && newData.child('title').val().length <= 60 && newData.child('from').isNumber() && newData.child('to').isNumber() && newData.child('from').val() >= 0 && newData.child('to').val() <= 24 && newData.child('to').val() > newData.child('from').val()",
          "days": {
            "$i": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/) && $i.matches(/^([0-9]|1[0-3])$/)"
            }
          }
        },
        "people": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 'f']) && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('f').isString() && newData.child('f').val().length <= 336 && newData.child('f').val().matches(/^[01]*$/)"
          }
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        }
      }
    },
    "study": {
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        "timer": {
          ".write": "auth != null && (!data.exists() || root.child('study').child($code).child('people').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['phase', 'running', 'endsAt', 'leftMs', 'focusMin', 'breakMin', 'rounds']) && (newData.child('phase').val() === 'focus' || newData.child('phase').val() === 'break') && newData.child('running').isBoolean() && newData.child('endsAt').isNumber() && newData.child('leftMs').isNumber() && newData.child('focusMin').isNumber() && newData.child('focusMin').val() <= 180 && newData.child('breakMin').isNumber() && newData.child('breakMin').val() <= 60 && newData.child('rounds').isNumber()"
        },
        "people": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 16 && (!newData.child('task').exists() || (newData.child('task').isString() && newData.child('task').val().length <= 60))"
          }
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        }
      }
    },
    "ketik": {
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        ".write": "auth != null && !newData.exists() && data.child('updatedAt').val() < now - 86400000",
        "meta": {
          ".write": "auth != null && (data.exists() ? data.child('host').val() === auth.uid : newData.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'mode', 'source', 'length', 'custom', 'limitSec', 'goal', 'targetScore', 'hostPlays', 'phase', 'startAt', 'round']) && newData.child('host').val() === (data.exists() ? data.child('host').val() : auth.uid)",
          "host": { ".validate": "newData.isString()" },
          "mode": {
            ".validate": "newData.isString() && newData.val().matches(/^(sentence|words)$/)"
          },
          "source": {
            ".validate": "newData.isString() && newData.val().matches(/^(sentences|words|custom)$/)"
          },
          "length": {
            ".validate": "newData.isString() && newData.val().matches(/^(short|medium|long)$/)"
          },
          "custom": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "goal": {
            ".validate": "newData.isString() && newData.val().matches(/^(time|points)$/)"
          },
          "targetScore": {
            ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 100000"
          },
          "limitSec": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 600"
          },
          "hostPlays": { ".validate": "newData.isBoolean()" },
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(lobby|race)$/)" },
          "startAt": { ".validate": "newData.isNumber()" },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000"
          },
          "$other": { ".validate": false }
        },
        "racers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 'av', 'round', 'pos', 'total', 'correct', 'errors', 'finishedAt', 'score', 'lives', 'outAt'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "av": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000"
            },
            "pos": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
            },
            "total": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
            },
            "correct": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "errors": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "finishedAt": { ".validate": "newData.isNumber()" },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "lives": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "outAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        }
      }
    },
    "sudokuRace": {
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        ".write": "auth != null && !newData.exists() && data.child('updatedAt').val() < now - 86400000",
        "meta": {
          ".write": "auth != null && (data.exists() ? data.child('host').val() === auth.uid : newData.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'level', 'rule', 'limitMin', 'hostPlays', 'phase', 'startAt', 'round']) && newData.child('host').val() === (data.exists() ? data.child('host').val() : auth.uid)",
          "host": {
            ".validate": "newData.isString()"
          },
          "level": {
            ".validate": "newData.isString() && newData.val().matches(/^(easy|medium|hard)$/)"
          },
          "rule": {
            ".validate": "newData.isString() && newData.val().matches(/^(penalty|strikes)$/)"
          },
          "limitMin": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
          },
          "hostPlays": {
            ".validate": "newData.isBoolean()"
          },
          "phase": {
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|race)$/)"
          },
          "startAt": {
            ".validate": "newData.isNumber()"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000"
          },
          "$other": {
            ".validate": false
          }
        },
        "racers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 'round', 'filled', 'total', 'mistakes', 'finishedAt'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000"
            },
            "filled": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 81"
            },
            "total": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 81"
            },
            "mistakes": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "finishedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "updatedAt": {
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        }
      }
    },
    "quiz": {
      ".indexOn": ["updatedAt"],
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/)",
        "game": {
          ".read": "auth != null",
          ".write": "auth != null && (data.exists() ? data.child('hostId').val() === auth.uid : newData.child('hostId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostId', 'title', 'questions', 'limitSec']) && newData.child('title').isString() && newData.child('title').val().length <= 60 && newData.child('limitSec').isNumber() && newData.child('limitSec').val() >= 5 && newData.child('limitSec').val() <= 60"
        },
        "secret": {
          ".read": "auth != null && root.child('quiz').child($code).child('game/hostId').val() === auth.uid",
          ".write": "auth != null && root.child('quiz').child($code).child('game/hostId').val() === auth.uid"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('quiz').child($code).child('game/hostId').val() === auth.uid",
          ".validate": "newData.hasChildren(['phase', 'index']) && newData.child('phase').val().matches(/^(lobby|question|reveal|end)$/) && newData.child('index').isNumber()"
        },
        "reveal": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('quiz').child($code).child('game/hostId').val() === auth.uid"
        },
        "scores": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('quiz').child($code).child('game/hostId').val() === auth.uid"
        },
        "hostHere": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('quiz').child($code).child('game/hostId').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          }
        },
        "answers": {
          ".read": "auth != null",
          "$i": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('quiz').child($code).child('state/phase').val() === 'question' && root.child('quiz').child($code).child('state/index').val() + '' === $i",
              ".validate": "newData.hasChildren(['choice', 'at']) && newData.child('choice').isNumber() && newData.child('choice').val() >= 0 && newData.child('choice').val() <= 3 && newData.child('at').val() === now"
            }
          }
        },
        "updatedAt": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.val() === now"
        }
      }
    }
  }
}
